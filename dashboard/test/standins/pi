#!/usr/bin/env python3
"""Stand-in for pi, never a model. In RPC mode it answers every prompt with one short turn of pi-shaped events: a
message with SLOW keeps the turn busy 3 s (abort ends it), SIM runs a fake `sierra test` that writes sim.json, ASKUI
asks a confirm. In json mode (-p, run.py's) it replies once per invocation: reply k of $STANDIN_REPLIES (a JSON list,
the last one repeating; default {"ok": true}), counted per session dir and list, and on the session's first invocation writes
$STANDIN_EDITS ([[path, text or null to delete]]) in its cwd. -c needs a session file there. Every command it gets goes
to $STANDIN_LOG, json mode with the stdin it read."""
import json, os, queue, sys, threading, time, zlib

LOG = os.environ.get('STANDIN_LOG')
out_lock, aborted, jobs = threading.Lock(), threading.Event(), queue.Queue()


def log(**kw):
    if LOG:
        with open(LOG, 'a') as f:
            f.write(json.dumps(dict(kw, who='pi', pid=os.getpid(), t=time.time())) + '\n')


def emit(ev):
    with out_lock:
        sys.stdout.write(json.dumps(ev) + '\n'); sys.stdout.flush()


def turn(msg):
    aborted.clear()
    emit({'type': 'agent_start'}); emit({'type': 'turn_start'})
    if 'SIM' in msg:
        cmd = 'sierra -C . test --json > sim.json'
        emit({'type': 'tool_execution_start', 'toolCallId': 'sim1', 'toolName': 'bash', 'args': {'command': cmd}})
        time.sleep(1.0)
        json.dump({'simulationRunId': 'run-x', 'tests': [{'passed': 3, 'total': 5}, {'passed': 5, 'total': 5}]}, open('sim.json', 'w'))
        emit({'type': 'tool_execution_end', 'toolCallId': 'sim1', 'toolName': 'bash', 'result': {'content': [{'type': 'text', 'text': 'ran'}]}, 'isError': False})
    if 'ASKUI' in msg:
        emit({'type': 'extension_ui_request', 'id': 'ui1', 'method': 'confirm', 'title': 'Go on?', 'message': 'stand-in asks'})
    if 'SLOW' in msg:
        for _ in range(30):
            if aborted.is_set():
                break
            time.sleep(0.1)
    text = 'ok: ' + msg[:40].replace('\n', ' ')
    emit({'type': 'message_start', 'message': {'role': 'assistant', 'content': []}})
    emit({'type': 'message_update', 'assistantMessageEvent': {'type': 'text_start', 'contentIndex': 0}})
    emit({'type': 'message_update', 'assistantMessageEvent': {'type': 'text_delta', 'contentIndex': 0, 'delta': text}})
    emit({'type': 'message_update', 'assistantMessageEvent': {'type': 'text_end', 'contentIndex': 0, 'content': text}})
    emit({'type': 'message_end', 'message': {'role': 'assistant', 'content': [{'type': 'text', 'text': text}], 'stopReason': 'aborted' if aborted.is_set() else 'stop',
                                             'usage': {'input': 100, 'output': 10, 'cacheRead': 50, 'reasoning': 0, 'cost': {'total': 0.01}}}})
    emit({'type': 'turn_end'}); emit({'type': 'agent_end'}); emit({'type': 'agent_settled'})


def worker():
    while True:
        turn(jobs.get())


def json_mode():
    args = sys.argv[1:]
    d = args[args.index('--session-dir') + 1]
    cont = '-c' in args
    stdin = sys.stdin.read()
    os.makedirs(d, exist_ok=True)
    files = [f for f in os.listdir(d) if f.endswith('.jsonl')]
    log(mode='json', argv=args, cwd=os.getcwd(), cont=cont, stdin=stdin, message=args[-1], sessions=len(files))
    if cont and not files:
        sys.stderr.write('No session to continue\n'); sys.exit(1)
    path = os.path.join(d, files[0] if files else 'standin.jsonl')
    k = sum(1 for _ in open(path)) if os.path.exists(path) else 0
    with open(path, 'a') as f:
        f.write(json.dumps({'stdin': stdin[:200], 'arg': args[-1][:200]}) + '\n')
    if k == 0:
        for rel, text in json.loads(os.environ.get('STANDIN_EDITS') or '[]'):
            if text is None:
                os.remove(rel)
            else:
                os.makedirs(os.path.dirname(rel) or '.', exist_ok=True)
                open(rel, 'w').write(text)
    raw = os.environ.get('STANDIN_REPLIES') or '["{\\"ok\\": true}"]'
    replies, counter = json.loads(raw), os.path.join(d, '.replies-%08x' % (zlib.crc32(raw.encode())))
    i = int(open(counter).read()) if os.path.exists(counter) else 0
    open(counter, 'w').write(str(i + 1))
    text = replies[min(i, len(replies) - 1)]
    emit({'type': 'session', 'id': 'standin-' + os.path.basename(d)})
    emit({'type': 'message_end', 'message': {'role': 'assistant', 'content': [{'type': 'text', 'text': text}], 'stopReason': 'stop',
                                             'usage': {'input': 100, 'output': 10, 'cacheRead': 0, 'reasoning': 0, 'cost': {'total': 0.01}}}})
    emit({'type': 'agent_end'})
    sys.exit(0)


if '--mode' in sys.argv and sys.argv[sys.argv.index('--mode') + 1] == 'json':
    json_mode()
log(argv=sys.argv[1:], cwd=os.getcwd())
if '--session-dir' in sys.argv and '--continue' not in sys.argv:
    d = sys.argv[sys.argv.index('--session-dir') + 1]
    os.makedirs(d, exist_ok=True)
    open(os.path.join(d, 'standin.jsonl'), 'w').write('{}\n')
threading.Thread(target=worker, daemon=True).start()
for line in sys.stdin:
    try:
        cmd = json.loads(line)
    except ValueError:
        continue
    log(cmd=cmd.get('type'), message=(cmd.get('message') or '')[:80], id=cmd.get('id'))
    emit({'type': 'response', 'command': cmd.get('type'), 'success': True})
    if cmd.get('type') in ('prompt', 'steer', 'follow_up'):
        jobs.put(cmd.get('message') or '')
    elif cmd.get('type') == 'abort':
        aborted.set()
while not jobs.empty():
    time.sleep(0.05)
sys.exit(0)
